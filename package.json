{
  "name": "@local/dsh-sensitive-data-guard",
  "version": "0.2.1",
  "description": "Sensitive Data Guard: zone-aware, fail-closed backup-before-delete gate for DeepSeek Harness",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "hooks/**",
    "bin/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "config.schema.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
